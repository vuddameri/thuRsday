library(sf)
library(zoo)
library(zoo)
library(plotly)
library(leaflet)
library(leafpop)
library(latex2exp)
# Set Path, Working Directory and File Names
path <- '/home/vuddameri/MathWorkshop/thuRsday-Lecture2/Data/'
setwd(path)
fname1 <- 'PRISM-SATX.csv'
fname2 <- 'SanAntonioBND.gpkg'
a <- read.csv(fname1,skip =10)
head(a)
colnames(a) <- c('Date','PPTIN','TMINF','TMEANF','TMAXF','TDMEAN','VPDMINHPA',
'VPDMAXHPA','SOLRAD')
Date <- as.Date(a$Date)
Tmints <- zoo(a$TMINF,order.by=Date)
png("TminPlot.png", width = 600, height = 400)
par(mgp=c(2,1,0))
plot(Tmints,xlab='Year',ylab=TeX("$Min. Temperature ^oF $"))
title('Daily Minimum Temperature',cex.main=0.9)
grid()
dev.off()
# Read the GeoPackage
sa <- st_read(fname2)
# Get the CRS
st_crs(sa)
sa <- st_transform(sa, 4326) # change to WGS84
plot(st_geometry(sa),  # plot the COSA boundary
col = NA,
border = "black")
# Make an Airport SF object
airport <- st_as_sf(
data.frame(
Name = "San Antonio Airport",
Lon = -98.47,
Lat = 29.53
),
coords = c("Lon", "Lat"),
crs = 4326
)
library(base64enc)
img <- dataURI(file = "TminPlot.png",
mime = "image/png")
popup <- paste0(
"<b>San Antonio Airport</b><br>",
"<img src='", img, "' width='500'>"
)
m <- leaflet()
m <- addTiles(m)
m <- addPolygons(
m,
data = sa,
fill = FALSE
)
m <- addCircleMarkers(
m,
data = airport,
radius = 6,
popup = popup
)
m
