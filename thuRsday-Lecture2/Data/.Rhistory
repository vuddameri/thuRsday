r <- 0.5
K <- 1000
# Constant yield
H <- 100
growthCY <- function(N) {
r * N * (1 - N/K) - H
}
# Constant effort
E <- 0.20
growthCE <- function(N) {
r * N * (1 - N/K) - E * N
}
# Compare at a depleted population
N <- 100
growthCY(N)
growthCE(N)
library(deSolve)
install.packages("deSolve")
library(deSolve)
times <- seq(0, 50, by = 0.1)
parms <- c(r = 0.5,
K = 1000,
H = 100)
state <- c(N = 800)
constYield <- function(t, state, parms) {
with(as.list(c(state, parms)), {
dN <- r*N*(1 - N/K) - H
list(c(dN))
})
}
out <- ode(y = state,
times = times,
func = constYield,
parms = parms)
plot(out)
parms <- c(r = 0.5,
K = 1000,
E = 0.2)
state <- c(N = 800)
constEffort <- function(t, state, parms) {
with(as.list(c(state, parms)), {
dN <- r*N*(1 - N/K) - E*N
list(c(dN))
})
}
out <- ode(y = state,
times = times,
func = constEffort,
parms = parms)
plot(out)
