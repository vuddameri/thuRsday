# largest equilibrium harvest
r <- 0.5
K <- 1000
H <- function(N) {
r*N*(1 - N/K)
}
optimize(H,
interval = c(0, K),
maximum = TRUE)
# Largest equilibrium yield - constant effort
equilibrium <- function(N, r, K, E) {
r*N*(1 - N/K) - E*N
}
Nstar <- uniroot(equilibrium,
interval = c(0.001, K),
r = r,
K = K,
E = E)$root
Nstar
