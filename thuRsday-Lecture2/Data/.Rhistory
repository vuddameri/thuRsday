times <- seq(0, 50, by = 0.1)
parms <- c(r = 0.5,
K = 1000,
H = 100)
state <- c(N = 200)
# Constant yield model
constYield <- function(t, state, parms) {
with(as.list(c(state, parms)), {
dN <- r*N*(1 - N/K) - H
list(c(dN))
})
